# ============================================================================
# .gitattributes — Geo-SmartSpanner
# فایل‌های HTML تعاملی و لاگ‌های خام را از شمارش زبان گیت‌هاب Linguist خارج می‌کند
# ============================================================================
docs/**/*.html linguist-vendored=true
*.html linguist-vendored=true
results/raw_runs/** linguist-generated=true
results/logs/** linguist-generated=true
*.csv linguist-vendored=true

src/**/*.py linguist-detectable=true
benchmarks/**/*.py linguist-detectable=true

*.md linguist-documentation=true
paper/**/*.tex linguist-documentation=true

* text=auto eol=lf
*.py text eol=lf

*.pt binary
*.pdf binary
*.png binary
